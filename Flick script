local LOCK_RANGE = 50
local LOCK_FOV = 100
local LOCK_SPEED = 0.1
local MAX_LOCK_TIME = 5

local isActive = false
local currentTarget = nil
local lockStartTime = 0
local originalCFrame = nil
local isTransitioning = false
local isDragging = false
local dragStart = nil
local frameStart = nil

local function getClosestPlayer()
    local closestPlayer = nil
    local closestDistance = LOCK_RANGE
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoidRootPart = player.Character:FindFirstChild("HumanoidRootPart")
            if humanoidRootPart then
                local screenPoint, onScreen = Camera:WorldToViewportPoint(humanoidRootPart.Position)
                
                if onScreen then
                    local mousePos = UserInputService:GetMouseLocation()
                    local distance = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePos).Magnitude
                    
                    if distance < closestDistance then
                        closestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    
    return closestPlayer
end

local function lockCameraToTarget()
    if not currentTarget or not currentTarget.Character then
        return
    end
    
    local head = currentTarget.Character:FindFirstChild("Head")
    if not head then return end
    
    if not originalCFrame then
        originalCFrame = Camera.CFrame
    end
    
    isTransitioning = true
    
    local targetPosition = head.Position + Vector3.new(0, 1, 0)
    local direction = (targetPosition - Camera.CFrame.Position).Unit
    
    Camera.CFrame = Camera.CFrame:Lerp(
        CFrame.lookAt(Camera.CFrame.Position, targetPosition),
        LOCK_SPEED
    )
end

local function releaseCamera()
    if not originalCFrame then return end
    
    local transitionTime = 0.5
    local startCFrame = Camera.CFrame
    local startTime = tick()
    
    while tick() - startTime < transitionTime do
        local alpha = (tick() - startTime) / transitionTime
        Camera.CFrame = startCFrame:Lerp(originalCFrame, alpha)
        RunService.RenderStepped:Wait()
    end
    
    Camera.CFrame = originalCFrame
    originalCFrame = nil
    isTransitioning = false
end

local function updateTargetCircle()
    if not isActive then
        TargetCircle.Visible = false
        TargetLabel.Visible = false
        return
    end
    
    TargetCircle.Visible = true
    
    if currentTarget then
        CircleStroke.Color = Color3.fromRGB(50, 255, 100)
        InnerStroke.Color = Color3.fromRGB(100, 255, 150)
        TargetLabel.Text = "ALVO: " .. currentTarget.Name
        TargetLabel.Visible = true
    else
        CircleStroke.Color = Color3.fromRGB(255, 50, 50)
        InnerStroke.Color = Color3.fromRGB(255, 100, 100)
        TargetLabel.Text = ""
        TargetLabel.Visible = false
    end
end

local function updateStatus()
    if isActive then
        StatusLabel.Text = "Status: ATIVADO"
        StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        ToggleButton.Text = "🔒 DESATIVAR FLICK LOCK"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(65, 200, 65)
    else
        StatusLabel.Text = "Status: Desativado"
        StatusLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
        ToggleButton.Text = "🔓 ATIVAR FLICK LOCK"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 65, 65)
    end
end

local function toggleSystem()
    isActive = not isActive
    
    if isActive then
        lockStartTime = tick()
        updateStatus()
        updateTargetCircle()
    else
        if currentTarget then
            releaseCamera()
            currentTarget = nil
        end
        updateStatus()
        updateTargetCircle()
    end
end

local function updateRange()
    local newRange = tonumber(RangeInput.Text)
    if newRange and newRange >= 10 and newRange <= 100 then
        LOCK_RANGE = newRange
        RangeInput.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    else
        RangeInput.Text = "50"
        LOCK_RANGE = 50
        RangeInput.BackgroundColor3 = Color3.fromRGB(80, 40, 40)
    end
end

local connection1 = nil
local connection2 = nil

local function startSystem()
    if connection1 then
        connection1:Disconnect()
    end
    if connection2 then
        connection2:Disconnect()
    end
    
    connection1 = RunService.RenderStepped:Connect(function()
        if not isActive then return end
        
        currentTarget = getClosestPlayer()
        
        if currentTarget then
            if tick() - lockStartTime > MAX_LOCK_TIME then
                toggleSystem()
                return
            end
            
            lockCameraToTarget()
        else
            if isTransitioning then
                releaseCamera()
            end
        end
        
        updateTargetCircle()
    end)
    
    connection2 = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        
        if input.KeyCode == Enum.KeyCode.F then
            toggleSystem()
        end
    end)
end

ToggleButton.MouseButton1Click:Connect(toggleSystem)

RangeInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        updateRange()
    end
end)

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isDragging = true
        dragStart = input.Position
        frameStart = MainFrame.Position
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            frameStart.X.Scale,
            frameStart.X.Offset + delta.X,
            frameStart.Y.Scale,
            frameStart.Y.Offset + delta.Y
        )
    end
end)

MainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isDragging = false
    end
end)

TitleBar.InputBegan:Connect(function(input)
