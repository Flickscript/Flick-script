local function createStaticClone()
    if not LocalPlayer.Character then return nil end
    
    local cloneFolder = Instance.new("Folder")
    cloneFolder.Name = "GhostClone_" .. LocalPlayer.UserId
    
    local rootPart = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    clonePosition = rootPart.Position
    
    for _, part in pairs(LocalPlayer.Character:GetChildren()) do
        if part:IsA("BasePart") then
            local clonePart = part:Clone()
            clonePart.Name = "Ghost_" .. part.Name
            clonePart.CanCollide = false
            clonePart.Anchored = true
            clonePart.Transparency = 0.3
            clonePart.Color = Color3.fromRGB(150, 150, 200)
            clonePart.Material = Enum.Material.Neon
            
            local surfaceAppearance = part:FindFirstChildOfClass("SurfaceAppearance")
            if surfaceAppearance then
                local cloneSurface = surfaceAppearance:Clone()
                cloneSurface.Parent = clonePart
            end
            
            local weldConstraint = part:FindFirstChildOfClass("WeldConstraint")
            if weldConstraint then
                local cloneWeld = weldConstraint:Clone()
                cloneWeld.Parent = clonePart
            end
            
            clonePart.Parent = cloneFolder
            
            if part.Name == "HumanoidRootPart" then
                clonePart.CFrame = CFrame.new(clonePosition)
            else
                local relativePosition = part.Position - rootPart.Position
                clonePart.Position = clonePosition + relativePosition
                clonePart.Rotation = part.Rotation
            end
        elseif part:IsA("Accessory") then
            local cloneAccessory = part:Clone()
            local handle = cloneAccessory:FindFirstChild("Handle")
            if handle then
                handle.CanCollide = false
                handle.Transparency = 0.3
                handle.Color = Color3.fromRGB(150, 150, 200)
                handle.Material = Enum.Material.Neon
            end
            cloneAccessory.Parent = cloneFolder
        end
    end
    
    local cloneHumanoid = Instance.new("Humanoid")
    cloneHumanoid.Name = "GhostHumanoid"
    cloneHumanoid.Health = 0
    cloneHumanoid.MaxHealth = 0
    cloneHumanoid.WalkSpeed = 0
    cloneHumanoid.JumpPower = 0
    cloneHumanoid.Parent = cloneFolder
    
    cloneFolder.Parent = workspace
    return cloneFolder
end

local function makePlayerInvisible()
    if not LocalPlayer.Character then return false end
    
    local character = LocalPlayer.Character
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return false end
    
    ghostClone = createStaticClone()
    if not ghostClone then return false end
    
    originalHumanoid = humanoid:Clone()
    
    for _, part in pairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.LocalTransparencyModifier = 1
        end
    end
    
    local newHumanoid = humanoid:Clone()
    newHumanoid.Parent = character
    humanoid:Destroy()
    
    newHumanoid.WalkSpeed = 24
    newHumanoid.JumpPower = 60
    
    invisibleHumanoid = newHumanoid
    
    if ghostConnection then
        ghostConnection:Disconnect()
    end
    
    ghostConnection = RunService.Heartbeat:Connect(function()
        if not ghostClone or not ghostClone.Parent then return end
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local playerChar = player.Character
                if playerChar then
                    for _, part in pairs(playerChar:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.LocalTransparencyModifier = 1
                        end
                    end
                end
            end
        end
    end)
    
    isGhostMode = true
    StatusLabel.Text = "Status: Ghost Mode"
    StatusLabel.TextColor3 = Color3.fromRGB(180, 120, 255)
    ToggleButton.Text = "👤 DESATIVAR GHOST"
    ToggleButton.BackgroundColor3 = Color3.fromRGB(60, 180, 60)
    
    return true
end

local function makePlayerVisible()
    if ghostConnection then
        ghostConnection:Disconnect()
        ghostConnection = nil
    end
    
    if ghostClone then
        ghostClone:Destroy()
        ghostClone = nil
    end
    
    if not LocalPlayer.Character then return end
    
    local character = LocalPlayer.Character
    
    for _, part in pairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.LocalTransparencyModifier = 0
        end
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local playerChar = player.Character
            if playerChar then
                for _, part in pairs(playerChar:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.LocalTransparencyModifier = 0
                    end
                end
            end
        end
    end
    
    if invisibleHumanoid and invisibleHumanoid.Parent == character then
        invisibleHumanoid:Destroy()
        invisibleHumanoid = nil
    end
    
    if originalHumanoid then
        local newHumanoid = originalHumanoid:Clone()
        newHumanoid.Parent = character
        
        local currentHumanoid = character:FindFirstChild("Humanoid")
        if currentHumanoid then
            currentHumanoid:Destroy()
        end
        
        originalHumanoid = nil
    end
    
    isGhostMode = false
    StatusLabel.Text = "Status: Visível"
    StatusLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    ToggleButton.Text = "👻 ATIVAR GHOST"
    ToggleButton.BackgroundColor3 = Color3.fromRGB(100, 60, 180)
end

local function toggleGhostMode()
    if isGhostMode then
        makePlayerVisible()
    else
        if makePlayerInvisible() then
            print("Ghost Mode ATIVADO - Clone estático criado")
        else
            print("Erro ao ativar Ghost Mode")
        end
    end
end

