local isDragging = false
local dragStart = nil
local frameStart = nil
local originalTransparency = {}
local originalCollision = {}

local function createClone()
    if not LocalPlayer.Character then return nil end
    
    local cloneFolder = Instance.new("Folder")
    cloneFolder.Name = "InvisibilityClone"
    
    for _, part in pairs(LocalPlayer.Character:GetChildren()) do
        if part:IsA("BasePart") then
            local clonePart = part:Clone()
            clonePart.Name = part.Name .. "_Clone"
            clonePart.CanCollide = false
            clonePart.Anchored = true
            clonePart.Parent = cloneFolder
            clonePart.Position = part.Position
            clonePart.Rotation = part.Rotation
            clonePart.Size = part.Size
            
            local weldConstraint = part:FindFirstChildOfClass("WeldConstraint")
            if weldConstraint then
                local cloneWeld = weldConstraint:Clone()
                cloneWeld.Parent = clonePart
            end
        elseif part:IsA("Accessory") then
            local cloneAccessory = part:Clone()
            cloneAccessory.Parent = cloneFolder
        end
    end
    
    cloneFolder.Parent = workspace
    return cloneFolder
end

local function makeInvisible()
    if not LocalPlayer.Character then return end
    
    playerClone = createClone()
    
    for _, part in pairs(LocalPlayer.Character:GetChildren()) do
        if part:IsA("BasePart") then
            originalTransparency[part] = part.Transparency
            originalCollision[part] = part.CanCollide
            
            part.Transparency = 1
            part.CanCollide = false
        elseif part:IsA("Accessory") and part:FindFirstChild("Handle") then
            local handle = part.Handle
            originalTransparency[handle] = handle.Transparency
            originalCollision[handle] = handle.CanCollide
            
            handle.Transparency = 1
            handle.CanCollide = false
        end
    end
    
    if LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = 32
        LocalPlayer.Character.Humanoid.JumpPower = 55
    end
    
    isInvisible = true
    StatusLabel.Text = "Status: Invisível"
    StatusLabel.TextColor3 = Color3.fromRGB(180, 65, 180)
    ToggleButton.Text = "👤 DESATIVAR INVISIBILIDADE"
    ToggleButton.BackgroundColor3 = Color3.fromRGB(65, 180, 65)
    
    print("Invisibilidade ATIVADA - Clone criado")
end

local function makeVisible()
    if playerClone then
        playerClone:Destroy()
        playerClone = nil
    end
    
    if LocalPlayer.Character then
        for part, transparency in pairs(originalTransparency) do
            if part and part.Parent then
                part.Transparency = transparency
            end
        end
        
        for part, canCollide in pairs(originalCollision) do
            if part and part.Parent then
                part.CanCollide = canCollide
            end
        end
        
        if LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.WalkSpeed = 16
            LocalPlayer.Character.Humanoid.JumpPower = 50
        end
    end
    
    originalTransparency = {}
    originalCollision = {}
    
    isInvisible = false
    StatusLabel.Text = "Status: Visível"
    StatusLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    ToggleButton.Text = "👻 ATIVAR INVISIBILIDADE"
    ToggleButton.BackgroundColor3 = Color3.fromRGB(180, 65, 180)
    
    print("Invisibilidade DESATIVADA - Clone removido")
end

local function toggleInvisibility()
    if isInvisible then
        makeVisible()
    else
        makeInvisible()
    end
end

